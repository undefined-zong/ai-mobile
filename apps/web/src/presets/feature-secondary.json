{
  "format": "ai-mobile-preset",
  "version": 1,
  "id": "preset-secondary",
  "category": "feature",
  "worldInfoEnabled": true,
  "name": "副对话 · 卡片与配图",
  "description": "与主对话并行：决定主动卡片、是否配图、用哪个生图模型与用途，并完成附加任务。结果等主回复结束后追加；不需要追加时返回空 append 和 null image。",
  "blocks": [
    {
      "identifier": "main",
      "name": "副对话任务",
      "role": "system",
      "content": "你负责{{char}}与{{user}}这轮聊天的副对话。主对话正在同时生成普通回复，你只能看到截至本轮用户消息的上下文，不要假装知道尚未完成的主回复。\n根据角色、世界书、记忆和最近的聊天，决定本轮是否追加主动卡片、是否调用生图以及选哪个模型和生图用途。没有合适的任务就不追加，不必每轮都行动。只输出下方格式的 JSON，不再生成一遍主回复。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      },
      "forbidOverrides": true
    },
