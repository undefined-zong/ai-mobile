{
  "format": "ai-mobile-preset",
  "version": 1,
  "id": "preset-image-duo",
  "category": "image",
  "worldInfoEnabled": false,
  "name": "生图 · 双人",
  "defaultFor": [
    "image-duo"
  ],
  "description": "心跳、陪伴学习、一起吃饭时坐在Ta旁边画的双人图：只给两个人的外观、服装 tags 和最近的对话，不加别的。",
  "blocks": [
    {
      "identifier": "main",
      "name": "任务",
      "role": "system",
      "content": "你是 NovelAI V4.5 的提示词写手：按最近的对话，把{{char}}和{{user}}此刻的画面写成 Danbooru 风格的英文 tags，两个人同框。两个人都是成年人。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "format",
      "name": "输出格式（### 和它前面的英文词别改）",
      "role": "system",
      "content": "只输出下面这几行，不要任何其他文字（### 和它前面的英文词别改，程序按它读）：\nimage###人数（例如 1girl, 1boy）和不属于某一个人的英文 tags###\nchar###{{char}}的人物类别（girl / boy / other）和{{char}}的英文 tags###\nuser###{{user}}的人物类别（girl / boy / other）和{{user}}的英文 tags###\n需要额外的负面 tags 时另起一行写 negative###英文 tags###。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "imageSubject",
      "name": "角色和外观 tags",
      "role": "user",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "imageCharacters",
      "name": "你的外观、服装 tags",
      "role": "user",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "imageRecent",
      "name": "最近的对话",
      "role": "user",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "imageScene",
      "name": "地点、服装、时间天气、表情（双人图不发）",
      "role": "user",
      "content": "",
      "marker": true,
      "enabled": false,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "imageCaption",
      "name": "要画的画面（双人图不发）",
      "role": "user",
      "content": "",
      "marker": true,
      "enabled": false,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    }
  ],
  "sampler": {
    "temperature": 0.7,
    "topP": 1,
    "maxTokens": 800,
    "contextTokens": 32000,
    "frequencyPenalty": 0,
    "presencePenalty": 0,
    "stream": false
  },
  "formats": {
    "newChatPrompt": "",
    "newExampleChatPrompt": "",
    "continueNudgePrompt": "",
    "impersonationPrompt": "",
    "sendIfEmpty": "",
    "wiFormat": "{0}",
    "scenarioFormat": "{{scenario}}",
    "personalityFormat": "{{personality}}",
    "namesBehavior": 0,
    "squashSystemMessages": false,
    "preferCharacterPrompt": true,
    "preferCharacterJailbreak": true
  },
  "regex": []
}
