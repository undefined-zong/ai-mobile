{
  "format": "ai-mobile-preset",
  "version": 1,
  "id": "preset-decor-life",
  "category": "feature",
  "worldInfoEnabled": true,
  "name": "小屋 · 角色生活",
  "defaultFor": [
    "decor-life"
  ],
  "description": "小人生活专用 API 预设：观察当前房间与双方状态，主动使用家具、回应用户并产生头顶气泡。可编辑性格、主动程度、日常习惯和对话风格。",
